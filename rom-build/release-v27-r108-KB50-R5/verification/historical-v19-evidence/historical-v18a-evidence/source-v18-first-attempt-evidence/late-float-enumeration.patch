+/* Serialize the new bounded checks against driver teardown. The callback
+ * and attach path may produce work; stop closes both before draining it. */
+static void r94_queue_sdp_check(struct dwc3_msm *mdwc, bool reset)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&mdwc->sdp_check_lock, flags);
+ if (!mdwc->sdp_check_stopping) {
+  if (reset)
+   mdwc->sdp_check_attempts = 0;
+  queue_delayed_work(mdwc->dwc3_wq, &mdwc->sdp_check,
+    msecs_to_jiffies(SDP_CONNETION_CHECK_TIME));
+ }
+ spin_unlock_irqrestore(&mdwc->sdp_check_lock, flags);
+}
+
+static void r94_stop_sdp_check(struct dwc3_msm *mdwc)
+{
+ unsigned long flags;
+ spin_lock_irqsave(&mdwc->sdp_check_lock, flags);
+ WRITE_ONCE(mdwc->sdp_check_stopping, true);
+ spin_unlock_irqrestore(&mdwc->sdp_check_lock, flags);
+ cancel_delayed_work_sync(&mdwc->sdp_check);
+}
