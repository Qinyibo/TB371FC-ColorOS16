From 1f6fc1fb5e47d5bf2447cd54173da213d3772008 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 2 Nov 2026 16:31:46 +0800
Subject: [PATCH 1/5] drm/sde: record deployed r6 display failure containment

Record the already deployed, reviewed change from its preserved patch.
This historical import does not rerun hardware tests or claim new acceptance.
---
 techpack/display/msm/sde/sde_connector.c | 32 ++++++++++++-----
 techpack/display/msm/sde/sde_connector.h |  3 ++
 techpack/display/msm/sde/sde_encoder.c   | 44 ++++++++++++++++++++++++
 3 files changed, 71 insertions(+), 8 deletions(-)

diff --git a/techpack/display/msm/sde/sde_connector.c b/techpack/display/msm/sde/sde_connector.c
index 8ced8b663..e4cf6b82f 100644
--- a/techpack/display/msm/sde/sde_connector.c
+++ b/techpack/display/msm/sde/sde_connector.c
@@ -2576,14 +2576,15 @@ static int sde_connector_atomic_check(struct drm_connector *connector,
 	return 0;
 }
 
-static void _sde_connector_report_panel_dead(struct sde_connector *conn,
-	bool skip_pre_kickoff)
+static bool _sde_connector_notify_panel_dead(struct sde_connector *conn)
 {
 	struct drm_event event;
-	struct dsi_display *display = (struct dsi_display *)(conn->display);
+	struct dsi_display *display;
 
-	if (!conn)
-		return;
+	if (!conn || !conn->display)
+		return false;
+
+	display = conn->display;
 
 	/* Panel dead notification can come:
 	 * 1) ESD thread
@@ -2591,7 +2592,7 @@ static void _sde_connector_report_panel_dead(struct sde_connector *conn,
 	 * So such case, avoid failure notification twice.
 	 */
 	if (conn->panel_dead)
-		return;
+		return false;
 
 	conn->panel_dead = true;
 	display->panel->mi_cfg.panel_dead_flag = true;
@@ -2599,11 +2600,26 @@ static void _sde_connector_report_panel_dead(struct sde_connector *conn,
 	event.length = sizeof(bool);
 	msm_mode_object_event_notify(&conn->base.base,
 		conn->base.dev, &event, (u8 *)&conn->panel_dead);
-	sde_encoder_display_failure_notification(conn->encoder,
-		skip_pre_kickoff);
 	SDE_EVT32(SDE_EVTLOG_ERROR);
 	SDE_ERROR("esd check failed report PANEL_DEAD conn_id: %d enc_id: %d\n",
 			conn->base.base.id, conn->encoder->base.id);
+	return true;
+}
+
+static void _sde_connector_report_panel_dead(struct sde_connector *conn,
+	bool skip_pre_kickoff)
+{
+	if (_sde_connector_notify_panel_dead(conn))
+		sde_encoder_display_failure_notification(conn->encoder,
+			skip_pre_kickoff);
+}
+
+/* A pre-enable rollback has no active encoder hardware to recover. Notify
+ * the existing userspace panel-recovery path without touching dead clocks. */
+void sde_connector_report_enable_failure(struct drm_connector *connector)
+{
+	if (connector)
+		_sde_connector_notify_panel_dead(to_sde_connector(connector));
 }
 
 int sde_connector_esd_status(struct drm_connector *conn)
diff --git a/techpack/display/msm/sde/sde_connector.h b/techpack/display/msm/sde/sde_connector.h
index ba9616da3..b9c8ccd18 100644
--- a/techpack/display/msm/sde/sde_connector.h
+++ b/techpack/display/msm/sde/sde_connector.h
@@ -991,6 +991,9 @@ int sde_connector_get_panel_vfp(struct drm_connector *connector,
  */
 int sde_connector_esd_status(struct drm_connector *connector);
 
+/* Report failed pre-enable without accessing unprepared encoder hardware. */
+void sde_connector_report_enable_failure(struct drm_connector *connector);
+
 /**
  * sde_connector_hbm_ctl - mi function to control hbm
  * @connector: Pointer to DRM connector object
diff --git a/techpack/display/msm/sde/sde_encoder.c b/techpack/display/msm/sde/sde_encoder.c
index 12cde44d3..36db8ac1f 100644
--- a/techpack/display/msm/sde/sde_encoder.c
+++ b/techpack/display/msm/sde/sde_encoder.c
@@ -492,6 +492,21 @@ bool sde_encoder_is_dsc_merge(struct drm_encoder *drm_enc)
 	return false;
 }
 
+/* The bridge rolled back this modeset before scanout started. No hardware
+ * kickoff or watchdog-vsync switch is valid on that powered-down output. */
+static bool sde_encoder_dsi_enable_failed(struct drm_encoder *enc)
+{
+	struct sde_encoder_virt *sde_enc = to_sde_encoder_virt(enc);
+	struct dsi_bridge *bridge;
+
+	if (sde_enc->disp_info.intf_type != DRM_MODE_CONNECTOR_DSI ||
+	    !enc->bridge)
+		return false;
+	bridge = container_of(enc->bridge, struct dsi_bridge, base);
+	return !bridge->r94_pre_enable_ok && bridge->display &&
+		bridge->display->r94_touch_resume_cancelled;
+}
+
 bool sde_encoder_is_primary_display(struct drm_encoder *drm_enc)
 {
 	struct sde_encoder_virt *sde_enc = to_sde_encoder_virt(drm_enc);
@@ -3449,6 +3464,9 @@ static void sde_encoder_virt_enable(struct drm_encoder *drm_enc)
 		return;
 	}
 
+	if (sde_encoder_dsi_enable_failed(drm_enc))
+		return;
+
 	_sde_encoder_input_handler_register(drm_enc);
 
 	if ((drm_enc->crtc && drm_enc->crtc->state &&
@@ -4996,6 +5014,11 @@ int sde_encoder_prepare_for_kickoff(struct drm_encoder *drm_enc,
 
 	_sde_encoder_helper_hdr_plus_mempool_update(sde_enc);
 
+	/* The failed frame is retired by kickoff below, after CRTC has accounted
+	 * for it. Do not attempt CTL/clock recovery on an unprepared panel. */
+	if (sde_encoder_dsi_enable_failed(drm_enc))
+		return 0;
+
 	/* prepare for next kickoff, may include waiting on previous kickoff */
 	SDE_ATRACE_BEGIN("sde_encoder_prepare_for_kickoff");
 	for (i = 0; i < sde_enc->num_phys_encs; i++) {
@@ -5136,6 +5159,27 @@ void sde_encoder_kickoff(struct drm_encoder *drm_enc, bool is_error)
 
 	SDE_DEBUG_ENC(sde_enc, "\n");
 
+	if (sde_encoder_dsi_enable_failed(drm_enc)) {
+		struct dsi_bridge *failed_bridge = container_of(drm_enc->bridge,
+				struct dsi_bridge, base);
+		struct drm_connector *conn = failed_bridge->display->drm_conn;
+
+		/* No transfer was started, so buffers can be retired with ERROR.
+		 * Use one CRTC event for the virtual encoder, not one per DSI half.
+		 * Do not manufacture a successful frame or touch-ready state. */
+		sde_enc->crtc_frame_event_cb_data.connector = conn;
+		if (sde_enc->crtc_frame_event_cb)
+			sde_enc->crtc_frame_event_cb(
+				&sde_enc->crtc_frame_event_cb_data,
+				SDE_ENCODER_FRAME_EVENT_ERROR |
+				SDE_ENCODER_FRAME_EVENT_SIGNAL_RELEASE_FENCE |
+				SDE_ENCODER_FRAME_EVENT_SIGNAL_RETIRE_FENCE);
+		sde_connector_report_enable_failure(conn);
+		SDE_ERROR_ENC(sde_enc, "R96_ENABLE_FAILED frame_retired_error\n");
+		SDE_ATRACE_END("encoder_kickoff");
+		return;
+	}
+
 	/* create a 'no pipes' commit to release buffers on errors */
 	if (is_error)
 		_sde_encoder_reset_ctl_hw(drm_enc);
-- 
2.43.0


