+/* ts->lock owns exactly one wake reference. A failed disable retains both
+ * kernel wake_depth and this flag; a later transition retries release and an
+ * intervening gesture suspend reuses it instead of incrementing the depth. */
+static int nvt_irq_wake_ctrl_locked(bool enable)
+{
+    int ret;
+
+    lockdep_assert_held(&ts->lock);
+    if (ts->irq_wake_enabled == enable)
+        return 0;
+    if (!ts->client || ts->client->irq <= 0)
+        return -EINVAL;
+    ret = enable ? enable_irq_wake(ts->client->irq) :
+                   disable_irq_wake(ts->client->irq);
+    if (!ret)
+        ts->irq_wake_enabled = enable;
+    else
+        NVT_ERR("R94_IRQ_WAKE_FAILED enable=%d ret=%d owned=%d\n",
+                enable, ret, ts->irq_wake_enabled);
+    return ret;
+}
